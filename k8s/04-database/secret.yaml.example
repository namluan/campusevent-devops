# Copier en secret.yaml (non versionne) puis changer les mots de passe.
# Les mots de passe events et bookings doivent etre identiques dans postgres-secret
# et dans le secret du service correspondant.
apiVersion: v1
kind: Secret
metadata:
  name: postgres-secret
  namespace: campusevents
stringData:
  POSTGRES_PASSWORD: changez-moi-1
  EVENTS_DB_PASSWORD: changez-moi-2
  BOOKINGS_DB_PASSWORD: changez-moi-3
---
apiVersion: v1
kind: Secret
metadata:
  name: events-db
  namespace: campusevents
stringData:
  DB_PASSWORD: changez-moi-2
---
apiVersion: v1
kind: Secret
metadata:
  name: bookings-db
  namespace: campusevents
stringData:
  DB_PASSWORD: changez-moi-3
